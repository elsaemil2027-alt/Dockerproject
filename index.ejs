<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%= basePath %>/styles.css" />
  </head>
  <body>
    <div class="bg-orb orb-a" aria-hidden="true"></div>
    <div class="bg-orb orb-b" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <main class="container">
      <header class="hero reveal">
    
        <h1 id="kinetic-title" class="title">Health Console</h1>
        <p class="subtitle">
          Live monitor for major APIs plus your own custom websites, with clean status insights and latency tracking.
        </p>
      </header>

      <section class="glass-panel reveal" aria-live="polite">
        <div class="panel-top">
          <div class="service">
            <span class="dot ok" aria-hidden="true"></span>
            <div>
              <h2>Platform Status</h2>
              <p>Use the API endpoints below to check live status.</p>
            </div>
          </div>
          <a class="refresh-btn" href="<%= basePath %>/api/scan">Run Scan</a>
        </div>

        <div class="metrics-grid">
          <article class="metric-card">
            <h3>Targets Up</h3>
            <p class="metric-value">API</p>
          </article>
          <article class="metric-card">
            <h3>Targets Down</h3>
            <p class="metric-value">Via</p>
          </article>
          <article class="metric-card">
            <h3>Avg Latency</h3>
            <p class="metric-value">JSON</p>
          </article>
          <article class="metric-card">
            <h3>Total Monitored</h3>
            <p class="metric-value">Routes</p>
          </article>
        </div>

        <form class="custom-form" action="<%= basePath %>/api/check" method="get" target="_blank" rel="noopener noreferrer">
          <label for="custom-url">Check any custom website/API URL</label>
          <div class="custom-row">
            <input id="custom-label" name="label" type="text" placeholder="Service label (optional)" maxlength="60" />
            <input id="custom-url" name="url" type="url" placeholder="https://example.com" required />
            <button class="refresh-btn" type="submit">Check URL (JSON)</button>
          </div>
          <p class="custom-result">Response opens as JSON in a new tab.</p>
        </form>

        <div class="table-wrap">
          <table class="status-table">
            <thead>
              <tr>
                <th>Service</th>
                <th>URL</th>
                <th>Status</th>
                <th>Code</th>
                <th>Latency</th>
                <th>Checked</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Health</td>
                <td><a href="<%= basePath %>/api/health"><%= basePath %>/api/health</a></td>
                <td><span class="state-pill state-ok">LINK</span></td>
                <td>200</td>
                <td>-</td>
                <td>On request</td>
              </tr>
              <tr>
                <td>Targets</td>
                <td><a href="<%= basePath %>/api/targets"><%= basePath %>/api/targets</a></td>
                <td><span class="state-pill state-ok">LINK</span></td>
                <td>200</td>
                <td>-</td>
                <td>On request</td>
              </tr>
              <tr>
                <td>Scan</td>
                <td><a href="<%= basePath %>/api/scan"><%= basePath %>/api/scan</a></td>
                <td><span class="state-pill state-ok">LINK</span></td>
                <td>200</td>
                <td>-</td>
                <td>On request</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="footer-row">
          <p>JavaScript removed for AWS-safe static rendering.</p>
        </div>
      </section>
    </main>
  </body>
</html>
